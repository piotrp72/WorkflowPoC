{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "orchestrator": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/orchestrator",
      "sourceRoot": "projects/orchestrator/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "tsConfig": "projects/orchestrator/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/orchestrator/public",
                "output": "."
              }
            ],
            "styles": ["projects/orchestrator/src/styles.css"],
            "main": "projects/orchestrator/src/main.ts",
            "outputPath": "dist/orchestrator",
            "index": "projects\\orchestrator\\src\\index.html",
            "extraWebpackConfig": "projects/orchestrator/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/orchestrator/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "orchestrator:build:production",
              "extraWebpackConfig": "projects/orchestrator/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "orchestrator:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 8081,
            "publicHost": "http://localhost:8081",
            "extraWebpackConfig": "projects/orchestrator/webpack.config.js"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
