{
  "name": "angular-mf-poc",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "run:all": "node node_modules/@angular-architects/module-federation/src/server/mf-dev-server.js",
    "start:orchestrator": "ng serve orchestrator --port 8081",
    "start:calculator": "ng serve calculator --port 8082",
    "start:collector": "ng serve collector --port 8083",
    "start:decision": "ng serve decision --port 8084",
    "start:orchestrator:when-ready": "wait-on tcp:8082 tcp:8083 tcp:8084 && npm run start:orchestrator",
    "start:all": "concurrently --names \"CALC,COL,DEC,ORCH\" \"npm run start:calculator\" \"npm run start:collector\" \"npm run start:decision\" \"npm run start:orchestrator:when-ready\""
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^21.2.2",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "ngx-build-plus": "^20.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
